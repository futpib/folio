# Copy to .env.local in this checkout. Empty or absent values are requested through Zond.
# Values are literal: no shell commands or variable expansion. Quotes are optional.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Self-generated keys: binance-keygen fills PRIVATE_KEY_FILE automatically.
BINANCE_PRIVATE_KEY_FILE=
# Alternatively paste PKCS#8 PEM on one line, with literal \n between its lines.
BINANCE_PRIVATE_KEY=
BINANCE_PRIVATE_KEY_PASSPHRASE=
BOG_USERNAME=
BOG_PASSWORD=
WOLT_EMAIL=
WOLT_USERNAME=
WOLT_PASSWORD=
IBKR_USERNAME=
IBKR_PASSWORD=
